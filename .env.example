# Environment variables required by the RAG chatbot feature.
# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Groq API key — the ONLY secret the deployed app needs at runtime.
# Used by /api/chat for chat generation (streamed responses via groq-sdk) and
# for the prompt-injection guard model. Set this in the Vercel project env.
#
# NOTE: embeddings run LOCALLY via @xenova/transformers (at build time for the
# index, and in-process at query time) — they need NO API token.
GROQ_API_KEY=
