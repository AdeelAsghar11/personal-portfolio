# Environment variables required by the RAG chatbot feature.
# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Groq API key — Primary LLM provider for chat generation and prompt guard.
GROQ_API_KEY=

# Google Gemini API key — Secondary failover LLM provider if Groq hits daily limits/outage.
GEMINI_API_KEY=
