# Environment variables required by the RAG chatbot feature.
# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Groq API key for chat generation (streamed responses via groq-sdk)
GROQ_API_KEY=

# Hugging Face token for build-time embeddings via the Inference API (BAAI/bge-small-en-v1.5)
HF_TOKEN=
